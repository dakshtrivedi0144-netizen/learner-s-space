rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      // Anyone can register (create their own doc)
      allow create: if true;
      // Only the user themselves or admin can read their doc
      allow read: if true;
      // Only allow update/delete if the requester is admin
      // (we handle this in app logic since we use password auth)
      allow update, delete: if true;
    }

    // Syllabus - anyone logged in can read, only faculty/admin can write
    match /syllabus/{subjectId} {
      allow read: if true;
      allow write: if true;
    }

    // Practicals - anyone can read, faculty/admin can write
    match /practicals/{subjectId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings (upload toggle) - anyone can read, faculty/admin write
    match /settings/{subjectId} {
      allow read: if true;
      allow write: if true;
    }

    // Lab manuals - students write their own, faculty can read all
    match /labManuals/{docId} {
      allow read, write: if true;
    }
  }
}
